NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000

# Supabase → Project Settings → Database → Connection string
# Transaction pooler (port 6543) — used by the app
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Session pooler / direct (port 5432) — used by drizzle-kit migrations
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Only if the project still uses the legacy JWT secret
SUPABASE_JWT_SECRET=

# Razorpay → Settings → API Keys (test mode first). Required from Phase 4.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
EMAIL_FROM=Clutch Culture <orders@clutchculture.in>
